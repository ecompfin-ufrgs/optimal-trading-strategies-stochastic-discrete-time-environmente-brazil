    "print('[sintetico] alpha*:', a, '| Merton:', merton, '| G(a*):', funcao_foc(a, R, 1+rf, g))\n",
    "assert abs(funcao_foc(a,R,1+rf,g)[0]) < 1e-6 and abs(a[0]-merton)/merton < 0.05\n",
