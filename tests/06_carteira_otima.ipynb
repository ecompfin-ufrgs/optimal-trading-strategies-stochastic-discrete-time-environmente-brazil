   "outputs": [],
   "source": [
    "import sys, os, tempfile\n",
    "_cwd = os.getcwd()\n",
    "RAIZ = os.path.dirname(_cwd) if os.path.basename(_cwd) == 'tests' else _cwd\n",
    "if RAIZ not in sys.path:\n",
    "    sys.path.insert(0, RAIZ)\n",
    "import numpy as np\n",
    "from scipy import optimize\n",
    "from app import dal          # so para ler a base real no teste (o algoritmo abaixo e' independente)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c2",
   "metadata": {},
   "source": [
    "## Desenvolvimento\n",
    "\n",
    "As funções abaixo foram escritas aqui e, após os testes, movidas para `app/nucleo.py`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c3",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-06T17:43:08.324728Z",
     "iopub.status.busy": "2026-08-06T17:43:08.324728Z",
     "iopub.status.idle": "2026-08-06T17:43:08.332012Z",
     "shell.execute_reply": "2026-08-06T17:43:08.332012Z"
    }
   },
   "outputs": [],
   "source": [
    "_TOL_FALENCIA = 1e-12\n",
    "\n",
    "# Bracket inicial do brentq (N=1), duplicado ate _MAX_EXPANSOES vezes.\n",
    "_BRACKET_INICIAL = 20.0\n",
    "_MAX_EXPANSOES = 8\n",
    "\n",
    "def funcao_foc(alpha, R, rf, gamma):\n",
    "    \"\"\"G(α) = E[(R − rf·1) / R_p^γ], com R_p = rf + αᵀ(R − rf·1). Shape (N,). (F6)\"\"\"\n",
    "    alpha = np.asarray(alpha, dtype=float)\n",
    "    excesso = R - rf                                    # (n, N)\n",
    "    R_p = np.maximum(rf + excesso @ alpha, _TOL_FALENCIA)  # (n,)\n",
    "    pesos = R_p ** (-gamma)\n",
    "    return (excesso.T @ pesos) / R.shape[0]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "0959b705",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _objetivo_J(alpha, R, rf, gamma):\n",
    "    \"\"\"J(α) = E[u(R_p(α))] — maximizado pelo solver (dJ/dα = G).\"\"\"\n",
    "    excesso = R - rf\n",
    "    R_p = np.maximum(rf + excesso @ alpha, _TOL_FALENCIA)\n",
    "    if np.isclose(gamma, 1.0):\n",
    "        u = np.log(R_p)\n",
    "    else:\n",
    "        u = R_p ** (1.0 - gamma) / (1.0 - gamma)\n",
    "    return float(u.mean())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "b6ea2bb4",
   "metadata": {},
   "outputs": [],
   "source": [
    "def resolver_alpha_otimo(R, rf, gamma, *, tol=1e-10, maxiter=200, alpha0=None):\n",
    "    \"\"\"Resolve a FOC G(α*)=0 maximizando J(α). (F6)\n",
    "\n",
    "    **Fiel ao artigo: α ∈ ℝ^N, SEM restrição alguma** — venda a descoberto\n",
    "    (α<0) e alavancagem (Σα>1) são sempre admitidas.\n",
    "    N ≥ 2 → SLSQP irrestrito; N = 1 → brentq com bracket auto-expansível.\n",
    "    \"\"\"\n",
    "    R = np.asarray(R, dtype=float)\n",
    "    N = R.shape[1]\n",
    "    if alpha0 is None:\n",
    "        alpha0 = np.full(N, 1.0 / N) \n",
    "\n",
    "    if N >= 2:\n",
    "        res = optimize.minimize(\n",
    "            lambda a: -_objetivo_J(a, R, rf, gamma), np.asarray(alpha0, float), \n",
    "            jac=lambda a: -funcao_foc(a, R, rf, gamma), \n",
    "            method=\"SLSQP\",\n",
    "            options={\"ftol\": tol, \"maxiter\": int(maxiter), \"disp\": False})\n",
    "        return res.x.copy()\n",
    "\n",
    "    # N == 1 — brentq. G decresce em α: procura-se G(lo) > 0 > G(hi).\n",
    "    g = lambda a: float(funcao_foc(np.array([a]), R, rf, gamma)[0]) \n",
    "    lo = -_BRACKET_INICIAL \n",
    "    hi = _BRACKET_INICIAL \n",
    "    for _ in range(_MAX_EXPANSOES):\n",
    "        if g(lo) > 0 > g(hi): \n",
    "            return np.array([optimize.brentq(g, lo, hi, xtol=tol)])\n",
    "        lo *= 2.0\n",
    "        hi *= 2.0\n",
    "    raise RuntimeError(\n",
    "        f\"FOC sem troca de sinal em α ∈ [{lo / 2:.0f}, {hi / 2:.0f}]: não há α* \"\n",
    "        \"finito.\"\n",
    "    )"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c4",
   "metadata": {},
   "source": [
    "**Teste** — resíduo da FOC ≈ 0 e aproximação de Merton (1 ativo), em dois cenários:\n",
    "\n",
    "1. **Amostra empírica real** — os próprios retornos diários do Ibovespa entram como o conjunto de cenários.\n",
    "2. **Controle sintético** — μ e σ *conhecidos por construção* e amostra grande."
   ]
  },
