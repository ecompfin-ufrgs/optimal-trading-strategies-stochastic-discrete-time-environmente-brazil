   "source": [
    "# 06 — Carteira ótima α* (FOC)\n",
    "\n",
    "Desenvolve `funcao_foc` e `resolver_alpha_otimo` (matemática pura). **F6.**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c1",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-06T17:43:07.355528Z",
     "iopub.status.busy": "2026-08-06T17:43:07.354537Z",
     "iopub.status.idle": "2026-08-06T17:43:08.321178Z",
