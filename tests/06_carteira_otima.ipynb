    "# (1) amostra EMPIRICA real: os proprios retornos do Ibovespa como cenarios\n",
    "db = os.path.join(RAIZ, 'data', 'mercado_diario.db')\n",
    "if os.path.exists(db):\n",
    "    ret = dal.ler_sqlite(db, 'retornos')\n",
    "    r_e = ret['ibov'].to_numpy(); rf_e = float(ret['cdi'].mean()); g_e = 5.0\n",
    "    R_e = np.maximum(1+r_e, 0).reshape(-1,1)\n",
    "    a_e = resolver_alpha_otimo(R_e, 1+rf_e, g_e); merton_e = (r_e.mean()-rf_e)/(g_e*r_e.var(ddof=1))\n",
    "    foc_e = funcao_foc(a_e, R_e, 1+rf_e, g_e)[0]\n",
    "    print(f\"[real] {len(ret)} pregoes, {ret['data'].iloc[0]} a {ret['data'].iloc[-1]} | rf={rf_e:.8f}/dia\")\n",
    "    print(f'[real] alpha*: {a_e[0]:+.6f} | Merton: {merton_e:+.6f} | G(a*): {foc_e:.2e}')\n",
    "    assert abs(foc_e) < 1e-6 and abs(a_e[0]-merton_e)/abs(merton_e) < 0.05\n",
    "    print('F6 carteira_otima (amostra empirica real): PASSOU')\n",
    "else:\n",
    "    print('data/mercado_diario.db ausente -> rode: python -m app.ingestao 2022-05-22 --diario')"
   ]
  },
